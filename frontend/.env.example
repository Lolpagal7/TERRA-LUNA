# Firebase Console > Project settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=astra-gnc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=astra-gnc
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set this to the deployed FastAPI URL when Hosting and the API are separate.
# Leave empty to use /api (works with the local Vite proxy).
VITE_API_BASE_URL=
